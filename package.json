{
  "name": "worldmonitor",
  "private": true,
  "version": "0.1.0",
  "description": "WorldMonitor monorepo entrypoint",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build:server": "npm --workspace server run build",
    "build:client": "npm --workspace client run build",
    "build": "npm run build:server && npm run build:client",
    "import:recent-victims": "npm --workspace server run import:recent-victims",
    "rebuild:aggregates": "npm --workspace server run rebuild:aggregates"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
